[Desktop Entry]
Type=Application
Name=Reckless Amphitheater
GenericName=Chess GUI
Comment=Play, analyse and run matches and tournaments between UCI chess engines
Exec=/opt/reckless-technology/bin/amphitheater %F
Icon=com.recklesstechnology.amphitheater
Terminal=false
Categories=Game;BoardGame;
Keywords=chess;UCI;engine;PGN;tournament;analysis;
MimeType=application/x-chess-pgn;
StartupWMClass=Reckless Amphitheater
