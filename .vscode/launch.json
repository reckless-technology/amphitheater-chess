{
    // Run > Start Debugging (F5) with one of these selected: the debug build (built first), under CodeLLDB on macOS
    // and Linux and the Visual Studio debugger on Windows. The matches play the tests' fake engine against itself.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CLI: perft (start position, depth 5)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/src/cli/amphitheater-cli",
            "args": ["perft", "startpos", "5"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "CLI: a match of fake engines",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/src/cli/amphitheater-cli",
            "args": ["match", "-engine", "cmd=${workspaceFolder}/build/debug/tests/amphitheater_fake_engine", "name=A",
                     "-engine", "cmd=${workspaceFolder}/build/debug/tests/amphitheater_fake_engine", "name=B",
                     "-each", "tc=10+0.1", "-games", "4", "-maxmoves", "40"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "Suite: chess",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/amphitheater_chess_test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "Suite: match",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/amphitheater_match_test",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "Windows CLI: perft (start position, depth 5)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/src/cli/amphitheater-cli.exe",
            "args": ["perft", "startpos", "5"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "Windows CLI: a match of fake engines",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/src/cli/amphitheater-cli.exe",
            "args": ["match", "-engine", "cmd=${workspaceFolder}/build/debug/tests/amphitheater_fake_engine.exe", "name=A",
                     "-engine", "cmd=${workspaceFolder}/build/debug/tests/amphitheater_fake_engine.exe", "name=B",
                     "-each", "tc=10+0.1", "-games", "4", "-maxmoves", "40"],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        },
        {
            "name": "Windows suite: match",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/tests/amphitheater_match_test.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build: debug"
        }
    ]
}
