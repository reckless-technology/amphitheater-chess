# The host's version, MAJOR.MINOR.BUILD, from git alone - the rule every Reckless project follows: MAJOR.MINOR is the
# nearest tag of the form vMAJOR.MINOR reachable from HEAD, made by hand (a release's own vMAJOR.MINOR.BUILD tags are
# three-component and excluded), and BUILD is the number of commits since it, the tagged commit itself being 0.
# Nothing in the tree is edited to release.
#
# A checkout with no such tag reachable (a shallow clone, a fork without the tags, or the repository before its first
# vMAJOR.MINOR tag) builds as 0.0.0 with a warning. Sets UCI_HOST_VERSION and its three parts, and writes the number
# into one header that one translation unit reads (src/cli/Version.cpp), so a new commit recompiles that file alone.
# The configure runs again when HEAD moves; after `git tag`, reconfigure by hand.
include_guard(GLOBAL)

find_package(Git QUIET)
set(_describe "")
set(_rc 1)
if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}" describe --tags --long
                --match "v[0-9]*.[0-9]*" --exclude "v*.*.*"
        OUTPUT_VARIABLE _describe
        OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE _rc
        ERROR_QUIET)
endif()
if(_rc EQUAL 0 AND _describe MATCHES "^v([0-9]+)\\.([0-9]+)-([0-9]+)-g[0-9a-f]+$")
    set(UCI_HOST_VERSION_MAJOR "${CMAKE_MATCH_1}")
    set(UCI_HOST_VERSION_MINOR "${CMAKE_MATCH_2}")
    set(UCI_HOST_VERSION_BUILD "${CMAKE_MATCH_3}")
else()
    message(WARNING "No vMAJOR.MINOR tag is reachable from HEAD (git describe said '${_describe}'): the build reports "
                    "0.0.0. Fetch the tags (git fetch --tags; CI checks out with fetch-depth 0).")
    set(UCI_HOST_VERSION_MAJOR 0)
    set(UCI_HOST_VERSION_MINOR 0)
    set(UCI_HOST_VERSION_BUILD 0)
endif()
set(UCI_HOST_VERSION "${UCI_HOST_VERSION_MAJOR}.${UCI_HOST_VERSION_MINOR}.${UCI_HOST_VERSION_BUILD}")
message(STATUS "Reckless UCI Host ${UCI_HOST_VERSION}")

file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/UciHostVersion.h" CONTENT [[
// Generated by cmake/UciHostVersion.cmake from the tags - do not edit, do not commit.
#pragma once
#define UCI_HOST_VERSION_STRING "@UCI_HOST_VERSION@"
]] @ONLY)

if(GIT_FOUND)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}" rev-parse --git-dir
        OUTPUT_VARIABLE _git_dir
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(_git_dir)
        if(NOT IS_ABSOLUTE "${_git_dir}")
            set(_git_dir "${CMAKE_SOURCE_DIR}/${_git_dir}")
        endif()
        foreach(_ref HEAD logs/HEAD packed-refs)
            if(EXISTS "${_git_dir}/${_ref}")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_git_dir}/${_ref}")
            endif()
        endforeach()
    endif()
endif()
